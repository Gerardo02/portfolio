package components

type navItem struct {
	Label string
	Href  string
}

var navLinks = []navItem{
	{Label: "Home", Href: "/"},
	{Label: "Projects", Href: "projects"},
	{Label: "Todo", Href: "todo"},
	{Label: "About", Href: "about"},
}

templ navLink(item navItem) {
	<a
		href={ templ.SafeURL(item.Href) }
		class="text-gray-400 hover:text-white transition-colors duration-200 text-sm font-medium"
		{ templ.Attributes{"href": templ.SafeURL(item.Href),"hx-get": item.Href, "hx-target": "#content", "hx-push-url": "true"}... }
	>
		{ item.Label }
	</a>
}

templ NavBar() {
	<header class="w-full bg-black px-6 py-4 flex items-center justify-between border-b border-white/10">
		<a
			href={ templ.SafeURL("/api/auth/login/google") }
			class="p-2 bg-zinc-800 border border-zinc-700 rounded-lg hover:bg-zinc-700 hover:cursor-pointer"
		>
			Login
		</a>
		<nav class="hidden md:flex items-center gap-8">
			for _, item := range navLinks {
				@navLink(item)
			}
		</nav>
		<!-- Mobile -->
		<label class="md:hidden cursor-pointer text-gray-400 hover:text-white" for="nav-toggle">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</label>
	</header>
	<!-- Mobile menu -->
	<input type="checkbox" id="nav-toggle" class="hidden peer"/>
	<div class="md:hidden max-h-0 overflow-hidden peer-checked:max-h-40 transition-all duration-300 bg-black border-b border-white/10">
		<div class="flex flex-col gap-4 px-6 py-4">
			for _, item := range navLinks {
				@navLink(item)
			}
		</div>
	</div>
}
