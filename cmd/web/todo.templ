package web

import (
	"portafolio/cmd/web/components"
	"portafolio/internal/data"
)

templ NoTask() {
	<span class="hidden" id="no-task" hx-swap-oob="true"></span>
}

templ Task(key, task string) {
	<div class="flex gap-2" { templ.Attributes{"id":  "hola-" + key}... }>
		<label { templ.Attributes{"for": key}... } class="bg-zinc-800 rounded-lg p-2 grow text-xl flex gap-4 hover:bg-zinc-700 hover:border-zinc-300 transition-all duration-200">
			<input { templ.Attributes{"id": key}... } class="self-center dark:border-white-400/20 dark:scale-100 transition-all duration-500 ease-in-out dark:hover:scale-110 dark:checked:scale-100 w-8 h-8" type="checkbox"/>
			<span class="self-center">
				{ task }
			</span>
		</label>
		<button { templ.Attributes{"hx-delete": "/task/" + key, "hx-target": "#" + "hola-" + key, "hx-swap": "delete" }... } class="text-2xl self-center rounded-xl font-medium text-red-800 hover:bg-red-950 hover:text-white p-2 transition-all duration-100 hover:cursor-pointer">Delete</button>
	</div>
}

templ TodoContent() {
	<div class="px-6 py-8 flex flex-col justify-center gap-6">
		<p class="text-4xl font-bold text-center">A todo app for good measure</p>
		<div class="mx-52 flex">
			<form
				hx-post="/task"
				hx-target="#tasks"
				hx-swap="beforeend"
				hx-on--after-request="this.reset()"
				class="grow"
			>
				<label
					for="new-task"
					class="p-6 gap-4 border text-2xl grow border-zinc-700 bg-zinc-800 rounded-md hover:bg-zinc-700 hover:border-zinc-300 flex"
				>
					<span>➕ Add task</span>
					<input
						id="new-task"
						name="task"
						class="grow outline-none bg-transparent placeholder-transparent focus:placeholder-zinc-400"
						placeholder="Add: take the trash out"
					/>
				</label>
			</form>
		</div>
		<div class="mx-52 flex flex-col justify-center gap-4" id="tasks">
			if len(data.Tasks) > 0 {
				for key, task := range data.Tasks {
					@Task(key, task)
				}
			} else {
				<span class="text-lg self-center" id="no-task">No tasks here :(</span>
			}
		</div>
	</div>
}

templ TodoApp() {
	@components.Base() {
		@TodoContent()
	}
}
